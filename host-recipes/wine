name=wine
revision=2
from_source=wine
clean_workdirs=no
imagedeps="build-essential mingw-w64 mingw-w64-i686-dev"
hostdeps="freetype pkgconfig"

configure() {
        ${source_dir}/configure \
        --prefix=/usr \
        --disable-tests \
	--enable-archs="i386,x86_64" \
        --disable-win16 \
	--without-x
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
