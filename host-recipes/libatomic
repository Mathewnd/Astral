name=libatomic
revision=2
from_source=gcc
imagedeps="build-essential"
hostdeps="automake autoconf xbinutils xgcc"
clean_workdirs=no
deps="mlibc"

build() {
	cd ${build_dir}/host-builds/xgcc
	make all-target-libatomic -j${paralellism}
}

package(){
	cd ${build_dir}/host-builds/xgcc
	make DESTDIR="${dest_dir}" install-target-libatomic
	rm -rf ${dest_dir}/usr/local/lib/gcc/x86_64-astral/14.3.0/
}
