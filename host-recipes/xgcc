name=xgcc
revision=3
from_source=gcc
imagedeps="build-essential libmpfr-dev libmpc-dev libgmp-dev"
hostdeps="automake autoconf xbinutils pkgconfig"
deps="mlibc-headers"
clean_workdirs=no

configure() {
	${source_dir}/configure --target=x86_64-astral --prefix=${prefix} --with-sysroot=${sysroot_dir} --enable-languages=c,c++,fortran --enable-threads=posix --enable-libgomp --disable-multilib --enable-shared --enable-host-shared --with-pic
}

build() {
	make all-gcc all-target-libgcc -j ${parallelism}
}

package(){
	make DESTDIR="${dest_dir}" install-gcc install-target-libgcc
}
