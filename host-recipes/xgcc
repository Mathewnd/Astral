name=xgcc
revision=6
from_source=gcc
imagedeps="build-essential libmpfr-dev libmpc-dev libgmp-dev"
hostdeps="automake autoconf xbinutils pkgconfig"
deps="mlibc-headers"
clean_workdirs=no

configure() {
	gmp_include_dir="/usr/include/$(gcc -print-multiarch)"
	[ -f "${gmp_include_dir}/gmp.h" ] || gmp_include_dir=/usr/include

	${source_dir}/configure --target=x86_64-astral --prefix=${prefix} --with-sysroot=${sysroot_dir} --with-gmp-include="${gmp_include_dir}" --enable-languages=c,c++,fortran --enable-threads=posix --enable-libgomp --disable-multilib --enable-shared --enable-host-shared --with-pic
}

build() {
	make all-gcc all-target-libgcc -j ${parallelism}
}

package(){
	make DESTDIR="${dest_dir}" install-gcc install-target-libgcc
}
