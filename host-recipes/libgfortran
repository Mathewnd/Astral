name=libgfortran
revision=2
from_source=gcc
imagedeps="build-essential libgmp-dev libmpfr-dev libmpc-dev"
hostdeps="automake autoconf xbinutils xgcc libquadmath"
clean_workdirs=no
deps="mlibc"

build() {
	cd ${build_dir}/host-builds/xgcc
	GFORTRAN_FOR_TARGET="${build_dir}/host-builds/xgcc/gcc/gfortran -B${build_dir}/host-builds/xgcc/gcc/" \
		make all-target-libgfortran -j${parallelism}
}

package(){
	cd ${build_dir}/host-builds/xgcc/x86_64-astral/libgfortran
	make DESTDIR="${dest_dir}" install
}
