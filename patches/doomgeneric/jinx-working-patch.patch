+    }
 }
 
 #ifdef ORIGCODE
@@ -318,6 +334,81 @@ static int GetAxisState(int axis, int invert)
     return result;
 }
 #endif
+
+static int ReadButtonState(int vbutton)
+{
+    int physbutton;
+
+    if (vbutton < NUM_VIRTUAL_BUTTONS)
+    {
+        physbutton = joystick_physical_buttons[vbutton];
+    }
+    else
+    {
+        physbutton = vbutton;
+    }
+
+    if (physbutton < 0 || physbutton >= 6)
+    {
+        return 0;
+    }
+
+    return (joystick_buttons_state & (1 << physbutton)) != 0;
+}
+
+static int GetButtonsState(void)
+{
+    int i;
+    int result;
+
+    result = 0;
+
+    for (i = 0; i < NUM_VIRTUAL_BUTTONS; ++i)
+    {
+        if (ReadButtonState(i))
+        {
+            result |= 1 << i;
+        }
+    }
+
+    return result;
+}
+
+static int GetAxisState(int axis, int invert)
+{
+    int result;
+
+    if (axis < 0)
+    {
+        return 0;
+    }
+
+    result = 0;
+
+    if (IS_BUTTON_AXIS(axis))
+    {
+        if (ReadButtonState(BUTTON_AXIS_NEG(axis)))
+        {
+            result -= 32767;
+        }
+        if (ReadButtonState(BUTTON_AXIS_POS(axis)))
+        {
+            result += 32767;
