 #include "i_system.h"
+#include "doomgeneric.h"
 
 #include "m_config.h"
 #include "m_misc.h"
@@ -41,6 +42,10 @@
 static SDL_Joystick *joystick = NULL;
 #endif
 
+static int joystick_available = 0;
+static int joystick_buttons_state = 0;
+static int joystick_axis_state[2] = {0, 0};
+
 // Configuration variables:
 
 // Standard default.cfg Joystick enable/disable
@@ -165,6 +170,17 @@ void I_InitJoystick(void)
 
     I_AtExit(I_ShutdownJoystick, true);
 #endif
+    int buttons;
+    int x;
