diff --git openrc-workdir/sh/init.sh.Astral.in openrc-workdir/sh/init.sh.Astral.in
new file mode 100644
index 0000000..c180f37
--- /dev/null
+++ openrc-workdir/sh/init.sh.Astral.in
@@ -0,0 +1,39 @@
+#!/bin/sh
+
+ebegin "Creating /tmp"
+mkdir -p /tmp
+eend $?
+
+ebegin "Cleaning up /etc/mtab"
+echo "" > /etc/mtab
+eend $?
+
+if [ ! -d /run ]; then
+    ebegin "Creating /run"
+    mkdir -p /run
+    eend $?
+fi
+
+ebegin "Mounting /run"
+mount /run -t tmpfs
+if [ $? != 0 ]; then
+    eerror "Unable to mount tmpfs on /run."
+    eerror "Can't continue."
+    exit 1
+fi
+eend
+
+ebegin "Creating $RC_SVCDIR"
+mkdir -p $RC_SVCDIR
+eend $?
+
+ebegin "Mounting tmpfs at $RC_SVCDIR"
+mount $RC_SVCDIR -t tmpfs
+eend $?
+
+if [ -d "$RC_CACHEDIR" ]; then
+	cp -pr "$RC_CACHEDIR"/* "$RC_SVCDIR" 2>/dev/null
+fi
+
+echo sysinit >"$RC_SVCDIR"/softlevel
+exit 0
