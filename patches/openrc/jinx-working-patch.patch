--- /dev/null
+++ openrc-workdir/init.d/netd.in
@@ -0,0 +1,22 @@
+#!@SBINDIR@/openrc-run
+
+description="start the network daemon"
+supervisor=supervise-daemon
+respawn_period="${respawn_period:-60}"
+command=/usr/sbin/netd
+command_args_foreground="${netd_options} ${netd_device}"
+pidfile="/run/${RC_SVCNAME}.pid"
+
+depend() {
+	after dev hostname
+	provide net
+}
+
+start_pre() {
+	export EINFO_QUIET="${quiet:-yes}"
+}
+
+stop_pre()
+{
+	export EINFO_QUIET="${quiet:-yes}"
+}
diff --git openrc-clean/init.d/root.in openrc-workdir/init.d/root.in
index 28be936..0807794 100644
--- openrc-clean/init.d/root.in
+++ openrc-workdir/init.d/root.in
@@ -20,6 +20,20 @@ depend()
 
 start()
 {
+	if [ "$RC_UNAME" = Astral ]; then
+		ebegin Updating /etc/mtab with root
+		# astral does not support remounting yet, nor ro mounts.
+		# add the root to /etc/mtab for accounting
+		local root_dev dev
+		root_dev=$(stat -c '%d' /)
+		for dev in /dev/*; do
+		  [ -b "$dev" ] && [ "$(stat -c '%r' "$dev")" = "$root_dev" ] && break
+		done
+		echo -e "$dev\t/\tunknown\tdefaults\t0\t0" >> /etc/mtab
+		eend
+		return 0
+	fi
+
 	local root_opts=",$(fstabinfo -o /),"
 	case "$root_opts" in
 		*,ro,*)
