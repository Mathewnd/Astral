+
+    if (!size) return NULL;
+    if (!src) return NULL;
+
+    if (size <= stack_size) dst = stack;
+    else if (!(dst = malloc( size ))) return NULL;
+
+    memcpy( dst, src, size );
+    return dst;
+}
+
+static void free_wow64_buffer( void *ptr, void *stack )
+{
+    if (ptr && ptr != stack) free( ptr );
+}
+
+static BOOL is_empty_forward_table( const NPI_MODULEID *module, UINT table )
+{
+#ifndef __linux__
+    if (table != NSI_IP_FORWARD_TABLE) return FALSE;
+    return NmrIsEqualNpiModuleId( module, &NPI_MS_IPV4_MODULEID ) ||
+           NmrIsEqualNpiModuleId( module, &NPI_MS_IPV6_MODULEID );
+#else
+    return FALSE;
+#endif
+}
+
+static NTSTATUS wow64_icmp_listen( void *args )
+{
+    struct icmp_listen_params32 *params32 = args;
+    struct icmp_listen_params params;
+    NTSTATUS status;
+
+    params.handle = params32->handle;
+    params.reply = ULongToPtr( params32->reply );
+    params.user_reply_ptr = params32->user_reply_ptr;
+    params.bits = params32->bits;
+    params.reply_len = params32->reply_len;
+    params.timeout = params32->timeout;
+
+    status = icmp_listen( &params );
+    params32->reply_len = params.reply_len;
+    return status;
+}
+
+static NTSTATUS wow64_icmp_send_echo( void *args )
+{
+    struct icmp_send_echo_params32 *params32 = args;
+    struct icmp_send_echo_params params;
+    NTSTATUS status;
+
+    params.src = ULongToPtr( params32->src );
+    params.dst = ULongToPtr( params32->dst );
+    params.request = ULongToPtr( params32->request );
+    params.reply = ULongToPtr( params32->reply );
+    params.request_size = params32->request_size;
+    params.reply_len = params32->reply_len;
+    params.bits = params32->bits;
+    params.ttl = params32->ttl;
+    params.tos = params32->tos;
+    params.hop_limit = params32->hop_limit;
+    params.handle = ULongToPtr( params32->handle );
+
+    status = icmp_send_echo( &params );
+    params32->reply_len = params.reply_len;
+    return status;
+}
+
+static NTSTATUS wow64_nsi_enumerate_all_ex( void *args )
+{
+    struct nsi_enumerate_all_ex32 *params32 = args;
+    struct nsi_enumerate_all_ex params;
+    NPI_MODULEID module;
+    NTSTATUS status;
+
+    if (is_native_wow64_args( args )) return unix_nsi_enumerate_all_ex( args );
+    if (!params32->module) return STATUS_INVALID_PARAMETER;
+
+    params.unknown[0] = ULongToPtr( params32->unknown[0] );
+    params.unknown[1] = ULongToPtr( params32->unknown[1] );
+    module = *(NPI_MODULEID *)ULongToPtr( params32->module );
+    params.module = &module;
+    params.table = params32->table;
+    if (is_empty_forward_table( &module, params.table ))
+    {
+        params32->count = 0;
+        return STATUS_SUCCESS;
+    }
+    params.first_arg = params32->first_arg;
+    params.second_arg = params32->second_arg;
+    params.key_data = ULongToPtr( params32->key_data );
+    params.key_size = params32->key_size;
+    params.rw_data = ULongToPtr( params32->rw_data );
+    params.rw_size = params32->rw_size;
+    params.dynamic_data = ULongToPtr( params32->dynamic_data );
+    params.dynamic_size = params32->dynamic_size;
+    params.static_data = ULongToPtr( params32->static_data );
+    params.static_size = params32->static_size;
+    params.count = params32->count;
+
+    status = nsi_enumerate_all_ex( &params );
+    params32->count = params.count;
+    return status;
+}
+
+static NTSTATUS wow64_nsi_get_all_parameters_ex( void *args )
+{
+    struct nsi_get_all_parameters_ex32 *params32 = args;
+    struct nsi_get_all_parameters_ex params;
+    BYTE key_stack[128];
+    NPI_MODULEID module;
+    void *key;
+    NTSTATUS status;
+
+    if (is_native_wow64_args( args )) return unix_nsi_get_all_parameters_ex( args );
+    if (!params32->module) return STATUS_INVALID_PARAMETER;
+    if (params32->key_size && !params32->key) return STATUS_INVALID_PARAMETER;
+
+    key = copy_wow64_buffer( params32->key, params32->key_size, key_stack, sizeof(key_stack) );
+    if (params32->key_size && !key) return STATUS_NO_MEMORY;
+
+    params.unknown[0] = ULongToPtr( params32->unknown[0] );
+    params.unknown[1] = ULongToPtr( params32->unknown[1] );
+    module = *(NPI_MODULEID *)ULongToPtr( params32->module );
+    params.module = &module;
+    params.table = params32->table;
+    params.first_arg = params32->first_arg;
+    params.unknown2 = params32->unknown2;
+    params.key = key;
+    params.key_size = params32->key_size;
+    params.rw_data = ULongToPtr( params32->rw_data );
+    params.rw_size = params32->rw_size;
+    params.dynamic_data = ULongToPtr( params32->dynamic_data );
+    params.dynamic_size = params32->dynamic_size;
+    params.static_data = ULongToPtr( params32->static_data );
+    params.static_size = params32->static_size;
+
+    status = nsi_get_all_parameters_ex( &params );
+    free_wow64_buffer( key, key_stack );
+    return status;
+}
+
+static NTSTATUS wow64_nsi_get_parameter_ex( void *args )
+{
+    struct nsi_get_parameter_ex32 *params32 = args;
+    struct nsi_get_parameter_ex params;
+    BYTE key_stack[128];
+    NPI_MODULEID module;
+    void *key;
+    NTSTATUS status;
+
+    if (is_native_wow64_args( args )) return unix_nsi_get_parameter_ex( args );
+    if (!params32->module) return STATUS_INVALID_PARAMETER;
+    if (params32->key_size && !params32->key) return STATUS_INVALID_PARAMETER;
+
+    key = copy_wow64_buffer( params32->key, params32->key_size, key_stack, sizeof(key_stack) );
+    if (params32->key_size && !key) return STATUS_NO_MEMORY;
+
+    params.unknown[0] = ULongToPtr( params32->unknown[0] );
+    params.unknown[1] = ULongToPtr( params32->unknown[1] );
+    module = *(NPI_MODULEID *)ULongToPtr( params32->module );
+    params.module = &module;
+    params.table = params32->table;
+    params.first_arg = params32->first_arg;
+    params.unknown2 = params32->unknown2;
+    params.key = key;
+    params.key_size = params32->key_size;
+    params.param_type = params32->param_type;
+    params.data = ULongToPtr( params32->data );
+    params.data_size = params32->data_size;
+    params.data_offset = params32->data_offset;
+
+    status = nsi_get_parameter_ex( &params );
+    free_wow64_buffer( key, key_stack );
+    return status;
+}
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    icmp_cancel_listen,
+    icmp_close,
+    wow64_icmp_listen,
+    wow64_icmp_send_echo,
+    wow64_nsi_enumerate_all_ex,
+    wow64_nsi_get_all_parameters_ex,
+    wow64_nsi_get_parameter_ex,
+    unix_nsi_get_notification,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == ARRAYSIZE(__wine_unix_call_funcs) );
+
