+ * paragraph) shall be included in all copies or substantial portions of the
+ * Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <linux/input.h>
+
+#include "input.h"
+#include "inputstr.h"
+#include "os.h"
+#include "Xprintf.h"
+#include "config-backends.h"
+
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+#define EVDEV_INPUT_DIR "/dev/input"
+#define EVDEV_EVENT_PREFIX "event"
+
+#define BITS_PER_LONG (sizeof(unsigned long) * 8)
+#define NBITS(x) ((((x) - 1) / BITS_PER_LONG) + 1)
+
+static Bool
+test_bit(const unsigned long *bits, int bit)
+{
+    return !!(bits[bit / BITS_PER_LONG] & (1UL << (bit % BITS_PER_LONG)));
+}
+
+static Bool
+is_event_node(const char *name)
+{
+    const char *p;
+
+    if (strncmp(name, EVDEV_EVENT_PREFIX, strlen(EVDEV_EVENT_PREFIX)) != 0)
+        return FALSE;
+
+    p = name + strlen(EVDEV_EVENT_PREFIX);
+    if (*p == '\0')
+        return FALSE;
+
+    while (*p) {
+        if (*p < '0' || *p > '9')
+            return FALSE;
+        p++;
+    }
+
+    return TRUE;
+}
+
+static Bool
+get_bits(int fd, int ev, unsigned long *bits, size_t size)
+{
+    memset(bits, 0, size);
+    return ioctl(fd, EVIOCGBIT(ev, size), bits) >= 0;
+}
+
+static Bool
+get_props(int fd, unsigned long *props, size_t size)
+{
+    memset(props, 0, size);
+    return ioctl(fd, EVIOCGPROP(size), props) >= 0;
+}
+
+static Bool
+has_keyboard_keys(const unsigned long *key_bits)
+{
+    int code;
+
+    for (code = KEY_ESC; code <= KEY_F24; code++) {
+        if (test_bit(key_bits, code))
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+static char *
+get_device_name(int fd, const char *path)
+{
+    char name[256];
+
+    memset(name, 0, sizeof(name));
+    if (ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name) >= 0 && name[0])
+        return strdup(name);
+
+    return strdup(path);
+}
+
+static void
+evdev_add_device(const char *path)
+{
+    unsigned long ev_bits[NBITS(EV_MAX + 1)];
+    unsigned long key_bits[NBITS(KEY_CNT)];
+    unsigned long rel_bits[NBITS(REL_MAX + 1)];
+    unsigned long abs_bits[NBITS(ABS_MAX + 1)];
+    unsigned long prop_bits[NBITS(INPUT_PROP_MAX + 1)];
+    struct input_id id;
+    Bool have_id;
+    InputAttributes attrs = { };
+    DeviceIntPtr dev = NULL;
+    InputOption *input_options = NULL;
+    char *config_info = NULL;
+    char *name = NULL;
+    int fd, rc;
+    int flags = O_RDONLY | O_NONBLOCK;
+
+#ifdef O_CLOEXEC
+    flags |= O_CLOEXEC;
+#endif
+
+    fd = open(path, flags);
+    if (fd == -1) {
+        LogMessageVerb(X_WARNING, 10, "config/evdev: open %s: %s\n",
+                       path, strerror(errno));
+        return;
+    }
+
+    if (!get_bits(fd, 0, ev_bits, sizeof(ev_bits))) {
+        LogMessageVerb(X_WARNING, 10,
+                       "config/evdev: EVIOCGBIT failed for %s: %s\n",
+                       path, strerror(errno));
+        close(fd);
+        return;
+    }
+
+    memset(key_bits, 0, sizeof(key_bits));
+    memset(rel_bits, 0, sizeof(rel_bits));
+    memset(abs_bits, 0, sizeof(abs_bits));
+    memset(prop_bits, 0, sizeof(prop_bits));
+
+    if (test_bit(ev_bits, EV_KEY))
+        get_bits(fd, EV_KEY, key_bits, sizeof(key_bits));
+    if (test_bit(ev_bits, EV_REL))
+        get_bits(fd, EV_REL, rel_bits, sizeof(rel_bits));
+    if (test_bit(ev_bits, EV_ABS))
+        get_bits(fd, EV_ABS, abs_bits, sizeof(abs_bits));
+    get_props(fd, prop_bits, sizeof(prop_bits));
+
+    if (test_bit(ev_bits, EV_KEY)) {
+        attrs.flags |= ATTR_KEY;
+
+        if (has_keyboard_keys(key_bits))
+            attrs.flags |= ATTR_KEYBOARD;
+    }
+
+    if (test_bit(ev_bits, EV_REL) &&
+        test_bit(rel_bits, REL_X) && test_bit(rel_bits, REL_Y))
+        attrs.flags |= ATTR_POINTER;
+
+    if (test_bit(ev_bits, EV_ABS) &&
+        test_bit(abs_bits, ABS_X) && test_bit(abs_bits, ABS_Y)) {
+        if (test_bit(prop_bits, INPUT_PROP_DIRECT))
+            attrs.flags |= ATTR_TOUCHSCREEN;
+        else if (test_bit(prop_bits, INPUT_PROP_POINTER) ||
+                 test_bit(key_bits, BTN_TOOL_FINGER))
+            attrs.flags |= ATTR_TOUCHPAD;
+        else if (test_bit(key_bits, BTN_TOOL_PEN) ||
+                 test_bit(key_bits, BTN_STYLUS) ||
+                 test_bit(key_bits, BTN_STYLUS2) ||
+                 test_bit(abs_bits, ABS_PRESSURE))
+            attrs.flags |= ATTR_TABLET;
+        else
+            attrs.flags |= ATTR_POINTER;
+    }
+
+    if (test_bit(key_bits, BTN_JOYSTICK) || test_bit(key_bits, BTN_GAMEPAD))
+        attrs.flags |= ATTR_JOYSTICK;
+
+    if (attrs.flags == 0) {
+        LogMessageVerb(X_INFO, 10,
+                       "config/evdev: ignoring input device %s without "
+                       "usable event capabilities\n", path);
+        close(fd);
+        return;
+    }
+
+    memset(&id, 0, sizeof(id));
+    have_id = ioctl(fd, EVIOCGID, &id) >= 0;
+    name = get_device_name(fd, path);
+    close(fd);
+    if (!name)
+        return;
+
+    if (Xasprintf(&config_info, "evdev:%s", path) == -1) {
+        config_info = NULL;
+        goto unwind;
+    }
+
+    if (device_is_duplicate(config_info)) {
+        LogMessage(X_WARNING, "config/evdev: device %s already added. "
+                   "Ignoring.\n", name);
+        goto unwind;
+    }
+
+    input_options = input_option_new(NULL, "_source", "server/evdev");
+    if (!input_options)
+        goto unwind;
+
+    input_options = input_option_new(input_options, "name", name);
+    input_options = input_option_new(input_options, "path", path);
+    input_options = input_option_new(input_options, "device", path);
+    input_options = input_option_new(input_options, "driver", "evdev");
+    if (attrs.flags & ATTR_KEYBOARD)
+        input_options = input_option_new(input_options, "xkb_rules", "evdev");
+    input_options = input_option_new(input_options, "config_info", config_info);
+
+    attrs.product = strdup(name);
+    attrs.device = strdup(path);
+
+    if (have_id && id.vendor && id.product &&
+        Xasprintf(&attrs.usb_id, "%04x:%04x", id.vendor, id.product) == -1)
+        attrs.usb_id = NULL;
+
+    LogMessage(X_INFO, "config/evdev: Adding input device %s (%s)\n",
+               name, path);
+    rc = NewInputDeviceRequest(input_options, &attrs, &dev);
+    if (rc != Success)
+        LogMessage(X_WARNING, "config/evdev: failed to add %s\n", path);
+
+ unwind:
+    input_option_free_list(&input_options);
+    free(config_info);
+    free(name);
+    free(attrs.product);
+    free(attrs.device);
+    free(attrs.usb_id);
+}
+
+static void
+evdev_add_devices(void)
+{
+    DIR *dir;
+    struct dirent *ent;
+
+    dir = opendir(EVDEV_INPUT_DIR);
+    if (!dir) {
+        LogMessage(X_WARNING, "config/evdev: opendir %s: %s\n",
+                   EVDEV_INPUT_DIR, strerror(errno));
+        return;
+    }
+
+    while ((ent = readdir(dir)) != NULL) {
+        char path[PATH_MAX];
+
+        if (!is_event_node(ent->d_name))
+            continue;
+
+        if (snprintf(path, sizeof(path), "%s/%s", EVDEV_INPUT_DIR,
+                     ent->d_name) >= (int) sizeof(path)) {
+            LogMessage(X_WARNING, "config/evdev: path too long: %s/%s\n",
+                       EVDEV_INPUT_DIR, ent->d_name);
+            continue;
+        }
+
+        evdev_add_device(path);
+    }
+
+    closedir(dir);
+}
+
+int
+config_evdev_init(void)
+{
+    evdev_add_devices();
+    return 1;
+}
+
+void
+config_evdev_fini(void)
+{
+}
