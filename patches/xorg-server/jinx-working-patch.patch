diff --git xorg-server-workdir/config/evdev.c xorg-server-workdir/config/evdev.c
new file mode 100644
index 0000000..6e18738
--- /dev/null
+++ xorg-server-workdir/config/evdev.c
@@ -0,0 +1,303 @@
+/*
