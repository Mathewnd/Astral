diff --git fastfetch-workdir/src/detection/loadavg/loadavg_astral.c fastfetch-workdir/src/detection/loadavg/loadavg_astral.c
new file mode 100644
index 0000000..762524a
--- /dev/null
+++ fastfetch-workdir/src/detection/loadavg/loadavg_astral.c
@@ -0,0 +1,15 @@
+#include "loadavg.h"
+
+#include <sys/sysinfo.h>
+
+const char* ffDetectLoadavg(double result[3])
+{
+    struct sysinfo si;
+    if(sysinfo(&si) < 0)
+        return "sysinfo() failed";
+
+    for(int i = 0; i < 3; ++i)
+        result[i] = (double) si.loads[i] / (1 << SI_LOAD_SHIFT);
+
+    return NULL;
+}
diff --git fastfetch-workdir/src/detection/memory/memory_astral.c fastfetch-workdir/src/detection/memory/memory_astral.c
new file mode 100644
index 0000000..3eb849c
--- /dev/null
+++ fastfetch-workdir/src/detection/memory/memory_astral.c
@@ -0,0 +1,16 @@
+#include "memory.h"
+#include <sys/sysinfo.h>
+#include <unistd.h>
+
+const char* ffDetectMemory(FFMemoryResult* ram)
+{
+    struct sysinfo info;
+    if(sysinfo(&info)) {
+        return "sysinfo() failed";
+    }
+
+    ram->bytesTotal = (uint64_t)(info.totalram * info.mem_unit);
+    ram->bytesUsed = (uint64_t)((info.totalram - info.freeram) * info.mem_unit);
+
+    return NULL;
+}
diff --git fastfetch-workdir/src/detection/packages/packages_astral.c fastfetch-workdir/src/detection/packages/packages_astral.c
new file mode 100644
index 0000000..04b46bf
--- /dev/null
+++ fastfetch-workdir/src/detection/packages/packages_astral.c
@@ -0,0 +1,57 @@
+#include "packages.h"
+
+#include "common/io.h"
+#include "common/stringUtils.h"
+
+#include <dirent.h>
+#include <string.h>
+
+static uint32_t countStrings(const char* path, const char* needle)
+{
+    FF_STRBUF_AUTO_DESTROY content = ffStrbufCreate();
+    if(!ffReadFileBuffer(path, &content))
+        return 0;
+
+    uint32_t count = 0;
+    char* iter = content.chars;
+    size_t needleLength = strlen(needle);
+
+    while((iter = memmem(iter, content.length - (size_t) (iter - content.chars), needle, needleLength)) != NULL)
+    {
+        ++count;
+        iter += needleLength;
+    }
+
+    return count;
+}
+
+static uint32_t getXBPS(void)
+{
+    FF_STRBUF_AUTO_DESTROY path = ffStrbufCreateStatic(FASTFETCH_TARGET_DIR_ROOT "/var/db/xbps");
+    uint32_t baseLength = path.length;
+
+    FF_AUTO_CLOSE_DIR DIR* dir = opendir(path.chars);
+    if(dir == NULL)
+        return 0;
+
+    struct dirent* entry;
+    while((entry = readdir(dir)) != NULL)
+    {
+        if(!ffStrStartsWithIgnCase(entry->d_name, "pkgdb-"))
+            continue;
+
+        ffStrbufAppendC(&path, '/');
+        ffStrbufAppendS(&path, entry->d_name);
+        uint32_t result = countStrings(path.chars, "<key>pkgver</key>");
+        ffStrbufSubstrBefore(&path, baseLength);
+        return result;
+    }
+
+    return 0;
+}
+
+void ffDetectPackagesImpl(FFPackagesResult* result, FFPackagesOptions* options)
+{
+    if(!(options->disabled & FF_PACKAGES_FLAG_XBPS_BIT))
+        result->xbps = getXBPS();
+}
