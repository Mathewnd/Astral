+
+const char* ffDetectSwap(FFlist* result)
+{
+    struct sysinfo info;
+    if(sysinfo(&info)) {
+        return "sysinfo() failed";
+    }
+
+    FFSwapResult* swap = ffListAdd(result);
+
+    ffStrbufInitStatic(&swap->name, "Total");
