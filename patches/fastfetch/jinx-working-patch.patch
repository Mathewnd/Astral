diff --git fastfetch-workdir/src/detection/cpu/cpu_astral.c fastfetch-workdir/src/detection/cpu/cpu_astral.c
new file mode 100644
index 0000000..0814baa
--- /dev/null
+++ fastfetch-workdir/src/detection/cpu/cpu_astral.c
@@ -0,0 +1,44 @@
+#include "cpu.h"
+#include <cpuid.h>
+
+void cpuid_brand_string(char buffer[49]) {
+    uint32_t regs[12];
+
+    __get_cpuid(0x80000000, regs + 0, regs + 1, regs + 2, regs + 3);
+    if (regs[0] < 0x80000004) {
+        strcpy(buffer, "Unknown");
+        return;
+    }
+
+    __get_cpuid(0x80000002, regs + 0, regs + 1, regs + 2, regs + 3);
+    __get_cpuid(0x80000003, regs + 4, regs + 5, regs + 6, regs + 7);
+    __get_cpuid(0x80000004, regs + 8, regs + 9, regs + 10, regs + 11);
+
+    memcpy(buffer, regs, sizeof(regs));
+    buffer[sizeof(regs)] = '\0';
+}
+
+void cpuid_vendor_string(char buffer[13]) {
+    uint32_t regs[4];
+
+    __get_cpuid(0x0, regs + 3, regs + 0, regs + 2, regs + 1);
+
+    memcpy(buffer, regs, sizeof(uint32_t) * 3);
+    buffer[12] = '\0';
+}
+
+const char* ffDetectCPUImpl(FF_MAYBE_UNUSED const FFCPUOptions* options, FF_MAYBE_UNUSED FFCPUResult* cpu)
+{
+    // Brand/Model
+    char brandBuffer[49];
+    cpuid_brand_string(brandBuffer);
+    ffStrbufSetS(&cpu->name, brandBuffer);
+
+    // Vendor String
+    char vendorBuffer[13];
+    cpuid_vendor_string(vendorBuffer);
+    ffStrbufSetS(&cpu->vendor, vendorBuffer);
+
+    ffCPUDetectByCpuid(cpu);
+    return NULL;
+}
diff --git fastfetch-workdir/src/detection/disk/disk_astral.c fastfetch-workdir/src/detection/disk/disk_astral.c
new file mode 100644
index 0000000..2f94822
--- /dev/null
+++ fastfetch-workdir/src/detection/disk/disk_astral.c
@@ -0,0 +1,88 @@
+#include "disk.h"
+
+#include "common/stringUtils.h"
+
+#include <mntent.h>
+#include <string.h>
+#include <sys/statvfs.h>
+
+static bool isPhysicalDevice(const struct mntent* device)
+{
+    if(ffStrEquals(device->mnt_dir, "/"))
+        return true;
+
+    return ffStrStartsWith(device->mnt_fsname, "/dev/");
+}
+
+static void detectName(FFDisk* disk)
+{
+    if(!ffStrbufStartsWithS(&disk->mountFrom, "/dev/"))
+        return;
+
+    const char* slash = strrchr(disk->mountFrom.chars, '/');
+    if(slash != NULL && slash[1] != '\0')
+        ffStrbufAppendS(&disk->name, slash + 1);
+}
+
+static void detectStats(FFDisk* disk)
+{
+    struct statvfs fs;
+    if(statvfs(disk->mountpoint.chars, &fs) != 0)
+        memset(&fs, 0, sizeof(fs));
+
+    disk->bytesTotal = fs.f_blocks * (uint64_t) fs.f_frsize;
+    disk->bytesFree = fs.f_bfree * (uint64_t) fs.f_frsize;
+    disk->bytesAvailable = fs.f_bavail * (uint64_t) fs.f_frsize;
+    disk->bytesUsed = 0;
+
+    if(fs.f_files >= fs.f_ffree)
+    {
+        disk->filesTotal = (uint32_t) fs.f_files;
+        disk->filesUsed = (uint32_t) (fs.f_files - fs.f_ffree);
+    }
+
+    disk->createTime = 0;
+}
+
+const char* ffDetectDisksImpl(FFDiskOptions* options, FFlist* disks)
+{
+    FILE* mountsFile = setmntent(FASTFETCH_TARGET_DIR_ROOT "/etc/mtab", "r");
+    if(mountsFile == NULL)
+        return "setmntent(\"/etc/mtab\", \"r\") == NULL";
+
+    struct mntent* device;
+    while((device = getmntent(mountsFile)) != NULL)
+    {
+        if(__builtin_expect(options->folders.length > 0, false))
+        {
+            if(!ffStrbufSeparatedContainS(&options->folders, device->mnt_dir, FF_DISK_FOLDER_SEPARATOR))
+                continue;
+        }
+        else if(!isPhysicalDevice(device))
+            continue;
+
+        if(options->hideFolders.length && ffDiskMatchesFolderPatterns(&options->hideFolders, device->mnt_dir, FF_DISK_FOLDER_SEPARATOR))
+            continue;
+
+        if(options->hideFS.length && ffStrbufSeparatedContainS(&options->hideFS, device->mnt_type, ':'))
+            continue;
+
+        FFDisk* disk = ffListAdd(disks);
+        disk->type = FF_DISK_VOLUME_TYPE_REGULAR_BIT;
+
+        ffStrbufInitS(&disk->mountFrom, device->mnt_fsname);
+        ffStrbufInitS(&disk->mountpoint, device->mnt_dir);
+        ffStrbufInitS(&disk->filesystem, device->mnt_type);
+
+        ffStrbufInit(&disk->name);
+        detectName(disk);
+
+        if(hasmntopt(device, MNTOPT_RO))
+            disk->type |= FF_DISK_VOLUME_TYPE_READONLY_BIT;
+
+        detectStats(disk);
+    }
+
+    endmntent(mountsFile);
+    return NULL;
+}
