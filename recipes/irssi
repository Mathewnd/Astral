name=irssi
revision=2
from_source=irssi
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base perl openssl ncurses glib"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
