name=libunistring
revision=1
from_source=libunistring
imagedeps="build-essential"
hostdeps="xgcc xbinutils libtool pkgconfig"
deps="base"

configure() {
	${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --disable-static --docdir=/usr/share/doc/libunistring-1.3
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
