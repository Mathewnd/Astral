name=icu
revision=2
from_source=icu
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool icu libstdc++-v3"
deps="base"

configure() {
	${source_dir}/source/configure --host=x86_64-astral --prefix=${prefix} --disable-static --with-cross-build=${build_dir}/host-builds/icu
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
