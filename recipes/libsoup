name=libsoup
revision=1
from_source=libsoup
imagedeps="gcc meson ninja-build libglib2.0-dev-bin"
hostdeps="xgcc xbinutils pkgconfig"
deps="base glib glib-networking libpsl libxml nghttp2 sqlite vala"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Dtests=false --wrap-mode=nofallback -Dtls_check=false ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
