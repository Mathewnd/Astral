name=binutils
revision=2
from_source=binutils
imagedeps="build-essential"
hostdeps="xgcc xbinutils automake autoconf"
deps="base"

configure() {
	${source_dir}/configure --host=x86_64-astral --target=x86_64-astral --prefix=${prefix} --disable-werror --enable-default-execstack=no
}

build() {
	make -j${parallelism} tooldir=/usr
}

package() {
	make install DESTDIR="${dest_dir}" tooldir=/usr
}
