name=dbus
revision=2
from_source=dbus
imagedeps="gcc meson ninja-build build-essential"
hostdeps="xgcc xbinutils pkgconfig"
deps="base libexpat libx11"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --localstatedir=/var --buildtype=release --wrap-mode=nofallback -Dsystemd=disabled -Depoll=disabled -Dkqueue=disabled -Dxml_docs=disabled -Ddoxygen_docs=disabled -Dducktype_docs=disabled -Dqt_help=disabled -Dmodular_tests=disabled -Dapparmor=disabled -Dselinux=disabled -Dlaunchd=disabled -Dvalgrind=disabled ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
