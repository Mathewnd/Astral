name=twm
revision=2
from_source=twm
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig autoconf automake libtool"
deps="base xorg-server xsetroot"

configure() {
	cp -rp ${source_dir}/* .
	./configure --prefix=${prefix} --host=x86_64-astral
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
