name=libuuid
revision=2
from_source=util-linux
imagedeps="build-essential python3 python3-dev"
hostrundeps="automake autoconf xgcc xbinutils libstdc++-v3 pkgconfig libtool"
deps="base gmp mpfr mpc binutils python"

configure() {
	cp -rp ${source_dir}/* .
	rm -rf po
	#./configure --host=x86_64-astral --prefix=${prefix} --enable-libuuid --enable-elf-shlibs --enable-subset
	./configure --host=x86_64-astral --prefix=${prefix} --enable-libuuid --disable-all-programs --enable-po --disable-nls --disable-static
}

#build() {
#	make -j ${parallelism} libuuid.la
#}

package() {
	make DESTDIR="${dest_dir}" install
	mv -v ${dest_dir}/lib/* ${dest_dir}/${prefix}/lib
	rm -r ${dest_dir}/lib
	rm ${dest_dir}/${prefix}/lib/libuuid.so{,.1}
	ln -sv libuuid.so.1.3.0 ${dest_dir}/${prefix}/lib/libuuid.so.1
	ln -sv libuuid.so.1 ${dest_dir}/${prefix}/lib/libuuid.so
}
