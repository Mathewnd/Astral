name=astral
revision=1
from_source=astral
imagedeps="build-essential nasm"
hostdeps="xgcc xbinutils limine"

build() {
	cp -pr "${source_dir}"/* .
	CC="x86_64-astral-gcc" LD="x86_64-astral-gcc" AS="nasm" TARGET=x86-64 make -j${parallelism}
}

package() {
	mkdir -p "${dest_dir}/boot"
	cp astral "${dest_dir}/boot"
}
