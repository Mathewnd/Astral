name=xedit
revision=2
from_source=xedit
imagedeps="gcc"
hostdeps="xgcc xbinutils pkgconfig"
deps="base libx11 xorgproto libxt libxaw libxmu"

configure() {
	${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --with-appdefaultdir=${prefix}/lib/X11/app-defaults
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
