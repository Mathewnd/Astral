name=libsecret
revision=1
from_source=libsecret
imagedeps="gcc meson ninja-build libglib2.0-dev-bin"
hostdeps="xgcc xbinutils pkgconfig"
deps="base glib libgcrypt vala"

configure() {
	CFLAGS="-Dg_variant_builder_init_static=g_variant_builder_init" meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Dgtk_doc=false -Dintrospection=false ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
