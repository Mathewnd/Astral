name=libxslt
revision=2
from_source=libxslt
imagedeps="build-essential libxml2"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base libxml"

configure() {
	PKG_CONFIG=/usr/local/bin/x86_64-astral-pkg-config ${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-static --without-python
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
