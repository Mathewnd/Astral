name=webkitgtk
revision=1
from_source=webkitgtk
imagedeps="build-essential libglib2.0-dev-bin ruby gperf unifdef"
hostdeps="xgcc xbinutils pkgconfig libtool libstdc++-v3 cmake libatomic"
deps="cairo gst-plugins-base gst-plugins-good gst-plugins-sndio gtk3 icu lcms libsecret libsoup libtasn1 libwebp mesa openjpeg ruby sqlite enchant glib hicolor-icon-theme libavif xdg-dbus-proxy harfbuzz libxslt"

configure() {
	cmake \
	-DPKG_CONFIG_EXECUTABLE="/usr/local/bin/x86_64-astral-pkg-config" \
	-DCMAKE_TOOLCHAIN_FILE=${base_dir}/util/cmake \
	-DCMAKE_INSTALL_PREFIX=${prefix} \
	-DCMAKE_BUILD_TYPE=Release \
	-DENABLE_STATIC=FALSE \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DPORT=GTK \
	-DCMAKE_SKIP_INSTALL_RPATH=ON \
	-DUSE_LIBBACKTRACE=OFF \
	-DUSE_LIBHYPHEN=OFF \
	-DENABLE_GAMEPAD=OFF \
	-DENABLE_MINIBROWSER=ON \
	-DENABLE_DOCUMENTATION=OFF \
	-DUSE_WOFF2=OFF \
	-DUSE_GTK4=OFF \
	-DENABLE_JOURNALD_LOG=OFF \
	-DENABLE_BUBBLEWRAP_SANDBOX=OFF \
	-DUSE_SYSPROF_CAPTURE=NO \
	-DENABLE_SPEECH_SYNTHESIS=NO \
	-DENABLE_INTROSPECTION=OFF \
	-DENABLE_WEBGL=ON \
	-DENABLE_VIDEO=ON \
	-DENABLE_WEB_AUDIO=ON \
	-DENABLE_MEDIA_SOURCE=ON \
	-DUSE_GSTREAMER_GL=ON \
	-DUSE_JPEGXL=OFF \
	-DUSE_SYSTEM_MALLOC=ON \
	-DCMAKE_SHARED_LINKER_FLAGS="-latomic" \
	-Wno-dev \
	-GNinja \
	${source_dir}
}

build() {
	ninja -j4
}

package() {
	DESTDIR=${dest_dir} ninja install
}
