name=openal
revision=1
from_source=openal
imagedeps="build-essential"
hostdeps="xgcc xbinutils libstdc++-v3 pkgconfig cmake"
deps="base sndio"

configure() {
	cmake \
	-DCMAKE_TOOLCHAIN_FILE=${base_dir}/util/cmake \
	-DCMAKE_INSTALL_PREFIX=${prefix} \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DALSOFT_BACKEND_SNDIO=ON \
	-DALSOFT_REQUIRE_SNDIO=ON \
	${source_dir}
}

build() {
	make -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} make install
}
