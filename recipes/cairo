name=cairo
revision=2
from_source=cairo
imagedeps="gcc meson ninja-build"
hostdeps="xgcc xbinutils pkgconfig"
deps="base fontconfig freetype glib libpng libx11 libxcb libxext libxrender pixman zlib"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release --wrap-mode=nofallback -Dtests=disabled -Dgtk_doc=false -Dglib=enabled -Dfontconfig=enabled -Dfreetype=enabled -Dpng=enabled -Dxlib=enabled -Dxcb=enabled -Dzlib=enabled -Dspectre=disabled -Dsymbol-lookup=disabled ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
