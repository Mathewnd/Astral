name=libevdev
revision=1
from_source=libevdev
imagedeps="gcc meson ninja-build"
hostdeps="xgcc xbinutils pkgconfig"
deps="base"

configure() {
    meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Ddocumentation=disabled -Dtests=disabled ${source_dir}
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR=${dest_dir} ninja install
}
