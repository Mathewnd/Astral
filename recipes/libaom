name=libaom
revision=1
from_source=libaom
imagedeps="build-essential yasm"
hostdeps="xgcc xbinutils pkgconfig libtool libstdc++-v3 cmake"
deps="base"

configure() {
	cmake \
	-DPKG_CONFIG_EXECUTABLE="/usr/local/bin/x86_64-astral-pkg-config" \
	-DCMAKE_TOOLCHAIN_FILE=${base_dir}/util/cmake \
	-DCMAKE_INSTALL_PREFIX=${prefix} \
	-DCMAKE_BUILD_TYPE=Release \
	-DENABLE_STATIC=FALSE \
	-DBUILD_SHARED_LIBS=1 \
	-DENABLE_DOCS=no \
	-G Ninja \
	-DCMAKE_INSTALL_LIBDIR=lib \
	${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
