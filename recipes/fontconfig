name=fontconfig
revision=4
from_source=fontconfig
imagedeps="build-essential python3 gperf"
hostdeps="xgcc xbinutils pkgconfig"
deps="base freetype libexpat"

configure() {
	ac_cv_va_copy=C99 ${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --enable-shared --disable-static --disable-nls
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
