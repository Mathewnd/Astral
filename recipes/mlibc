name=mlibc
from_source=mlibc
revision=12
hostdeps="xgcc xbinutils pkgconfig"
builddeps="freestnd-c-hdrs freestnd-cxx-hdrs frigg libsmarter"
imagedeps="meson ninja-build git build-essential binutils"
deps="mlibc-headers"

configure() {
        meson --cross-file ${base_dir}/util/crossfile -Dno_headers=true --prefix=${prefix} ${source_dir} -Dlinux_kernel_headers=${sysroot_dir}/${prefix}/include -Dposix_option=enabled -Dlinux_option=enabled -Dglibc_option=enabled -Dbsd_option=enabled
}

build() {
        ninja
}

package() {
        DESTDIR=${dest_dir} ninja install
}
