name=xdotool
revision=1
from_source=xdotool
imagedeps="meson build-essential"
hostdeps="xgcc xbinutils pkgconfig"
deps="base libx11 libxi libxkbcommon libxtst libxinerama"

configure() {
	cp -rp ${source_dir}/* .
}

build() {
	make -j${parallelism} WITHOUT_RPATH_FIX=1 CC=x86_64-astral-gcc
}

package() {
	make DESTDIR=${dest_dir} PREFIX=/usr install
}
