name=libvorbis
revision=1
from_source=libvorbis
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base libogg"

configure() {
	${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-static
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
