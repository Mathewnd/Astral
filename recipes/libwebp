name=libwebp
revision=2
from_source=libwebp
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base libjpeg-turbo libpng libtiff sdl2"

configure() {
	${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-static --enable-swap-16bit-csp --enable-libwebpextras --enable-libwebpdecoder --enable-libwebpdemux --enable-libwebpmux
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
