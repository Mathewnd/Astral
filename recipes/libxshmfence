name=libxshmfence
revision=2
from_source=libxshmfence
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig util-macros libtool pkgconfig"
deps="base xorgproto"

configure() {
    ${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --enable-shared --disable-static
}

build() {
    make -j${parallelism}
}

package() {
    make DESTDIR=${dest_dir} install
}
