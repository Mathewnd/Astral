name=libarchive
revision=2
from_source=libarchive
imagedeps="build-essential cmake"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base bzip2 libexpat libxml zlib"

configure() {
	#${source_dir}/configure --prefix=/usr --host=x86_64-astral --disable-static --enable-shared
	cmake \
	-DPKG_CONFIG_EXECUTABLE="/usr/local/bin/x86_64-astral-pkg-config" \
	-DCMAKE_TOOLCHAIN_FILE=${base_dir}/util/cmake \
	-DCMAKE_INSTALL_PREFIX=${prefix} \
	-DCMAKE_BUILD_TYPE=Release \
	-DENABLE_STATIC=FALSE \
	-DCMAKE_INSTALL_LIBDIR=lib \
	${source_dir}
}

build() {
	make -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} make install
}
