name=xrandr
revision=2
from_source=xrandr
imagedeps="gcc"
hostdeps="xgcc xbinutils pkgconfig"
deps="base xorgproto libx11 libxrandr"

configure() {
	${source_dir}/configure --prefix=${prefix} --host=x86_64-astral
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
