name=xdpyinfo
revision=1
from_source=xdpyinfo
imagedeps="gcc"
hostdeps="xgcc xbinutils pkgconfig"
deps="base libx11 libxext libxi libxrender libxinerama libxxf86vm libxtst libxcb libxrandr xcb-proto xorgproto"

configure() {
	${source_dir}/configure --prefix=${prefix} --host=x86_64-astral
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
