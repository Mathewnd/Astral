name=libxkbcommon
revision=1
from_source=libxkbcommon
imagedeps="gcc meson ninja-build"
hostdeps="xgcc xbinutils pkgconfig automake autoconf util-macros libtool"
deps="base xkeyboardconfig libxcb libxml"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} ${source_dir} -Denable-wayland=false
}

build() {
	ninja
}

package() {
	DESTDIR=${dest_dir} ninja install
}
