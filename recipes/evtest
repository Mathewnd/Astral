name=evtest
revision=1
from_source=evtest
imagedeps="gcc"
hostdeps="xgcc xbinutils pkgconfig automake autoconf"
deps="base libevdev"

configure() {
    ${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --disable-static
}

build() {
    make -j${parallelism}
}

package() {
    make DESTDIR=${dest_dir} install
}
