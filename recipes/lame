name=lame
revision=1
from_source=lame
imagedeps="build-essential nasm"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base libsndfile"

configure() {
	${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-static --enable-mp3rtp
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
