name=xf86-input-evdev
revision=1
from_source=xf86-input-evdev
imagedeps="gcc"
hostdeps="xgcc xbinutils pkgconfig automake autoconf util-macros libtool"
deps="base xorg-server libevdev mtdev"

configure() {
    ${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --disable-static --with-sdkdir=${prefix}/include/xorg
}

build() {
    make -j${parallelism}
}

package() {
    make DESTDIR=${dest_dir} install
}
