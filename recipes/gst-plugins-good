name=gst-plugins-good
revision=2
from_source=gst-plugins-good
imagedeps="gcc meson ninja-build libglib2.0-dev-bin nasm"
hostdeps="xgcc xbinutils pkgconfig libstdc++-v3"
deps="base gst-plugins-base cairo flac gdk-pixbuf mpg123 lame sndio"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Dtests=disabled ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
