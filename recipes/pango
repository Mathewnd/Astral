name=pango
revision=2
from_source=pango
imagedeps="gcc meson ninja-build build-essential libglib2.0-dev"
hostdeps="xgcc xbinutils pkgconfig"
deps="base cairo fontconfig freetype fribidi glib harfbuzz libxft"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release --wrap-mode=nofallback -Dintrospection=disabled ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
