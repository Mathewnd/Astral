name=sqlite
revision=3
from_source=sqlite
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base readline zlib"

configure() {
	${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-static --soname=legacy --enable-fts{4,5} CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 -D SQLITE_ENABLE_UNLOCK_NOTIFY=1 -D SQLITE_ENABLE_DBSTAT_VTAB=1 -D SQLITE_SECURE_DELETE=1"
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
