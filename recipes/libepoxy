name=libepoxy
revision=1
from_source=libepoxy
imagedeps="gcc meson ninja-build"
hostdeps="xgcc xbinutils pkgconfig"
deps="base mesa libx11"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Ddocs=false -Dtests=false -Dx11=true ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
