name=gstreamer
revision=2
from_source=gstreamer
imagedeps="gcc meson ninja-build libglib2.0-dev-bin"
hostdeps="xgcc xbinutils pkgconfig libstdc++-v3"
deps="base glib gtk3"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Dgst_debug=false -Dtests=disabled ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
