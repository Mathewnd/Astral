name=gcc
revision=4
from_source=gcc
imagedeps="build-essential"
hostrundeps="automake autoconf xgcc xbinutils libstdc++-v3"
deps="base gmp mpfr mpc binutils"
clean_workdirs=no

configure() {
	${source_dir}/configure --host=x86_64-astral --target=x86_64-astral --prefix=${prefix} --enable-languages=c,c++,fortran --enable-threads=posix --enable-libgomp --with-pic --with-sysroot=/ --with-build-sysroot=${sysroot_dir}
}

build() {
	make -j${parallelism} all-gcc all-target-libgcc all-target-libstdc++-v3
}

package() {
	make install-gcc install-target-libgcc install-target-libstdc++-v3 DESTDIR="${dest_dir}"
}
