name=fribidi
revision=1
from_source=fribidi
imagedeps="gcc meson ninja-build build-essential"
hostdeps="xgcc xbinutils pkgconfig"
deps="base"

configure() {
	meson --cross-file ${base_dir}/util/crossfile --prefix=${prefix} --buildtype=release -Ddocs=false -Dtests=false ${source_dir}
}

build() {
	ninja -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} ninja install
}
