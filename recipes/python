name=python
revision=1
from_source=python
imagedeps="build-essential zlib1g-dev"
hostdeps="xgcc xbinutils pkgconfig python"
deps="base zlib"

configure() {
	echo "ac_cv_file__dev_ptmx=yes" > /tmp/configsite
	echo "ac_cv_file__dev_ptc=no" >> /tmp/configsite
	CONFIG_SITE=/tmp/configsite ${source_dir}/configure --prefix=${prefix} --host=x86_64-astral --build=x86_64 --disable-ipv6 --enable-shared
}

build() {
	make -j${parallelism}
}

package() {
	make DESTDIR=${dest_dir} install
}
