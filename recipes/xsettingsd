name=xsettingsd
revision=2
from_source=xsettingsd
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libstdc++-v3 xorgproto cmake"
deps="base libxfixes libx11"

configure() {
	cmake \
	-DCMAKE_TOOLCHAIN_FILE=${base_dir}/util/cmake \
	-DCMAKE_INSTALL_PREFIX=${prefix} \
	-DCMAKE_BUILD_TYPE=Release \
	${source_dir}
}

build() {
	make -j${parallelism}
}

package() {
	DESTDIR=${dest_dir} make install
}
