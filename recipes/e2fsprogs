name=e2fsprogs
revision=2
from_source=e2fsprogs
imagedeps="build-essential"
hostdeps="xgcc xbinutils pkgconfig libtool"
deps="base libuuid"

configure() {
	${source_dir}/configure --host=x86_64-astral --prefix=${prefix} --disable-libuuid
}

build() {
	make -j ${parallelism}
}

package() {
	make install DESTDIR=${dest_dir}
}
