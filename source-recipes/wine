name=wine
_version_series="11.x"
version=11.4
source_method=tarball
tarball_url="https://dl.winehq.org/wine/source/${_version_series}/wine-${version}.tar.xz"
tarball_sha512="037ba964d80d50f25dafba2a24e334df5fe580998de229b6fd2ce040ef4835a232ebba4370b0d1e070c2d358841b2160b7f1c32af79b530093f19cc0b5edadb1"
hostdeps="autoconf automake pkgconfig libtool autoconf-archive"
prepare() {
        cp -v $(find /usr/local/share/automake* -name config.sub) tools/
        cp -v $(find /usr/local/share/automake* -name config.guess) tools/
        chmod +x configure
}
